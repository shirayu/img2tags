{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.yml", "**/*.yaml", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "nursery": {
        "noDuplicateMapKeys": "error",
        "noYamlBooleanKeys": "error"
      }
    }
  }
}
